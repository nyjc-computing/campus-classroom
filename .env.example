# Campus Classroom Environment Variables

# Required: Flask session secret key
SECRET_KEY=your-secret-key-here

# Required: Campus API credentials
CLIENT_ID=your-campus-client-id
CLIENT_SECRET=your-campus-client-secret

# Required: Environment (development, staging, or production)
ENV=development

# Optional: Explicit Campus service base URLs (campus-api-python#53).
# Normally unnecessary — the client derives them from ENV: development →
# Railway dev deployments, staging → *.campus.nyjc.dev, production →
# *.campus.nyjc.app. Set these only to override (e.g. local services).
# CAMPUS_AUTH_URL=https://campusauth-development.up.railway.app
# CAMPUS_API_URL=https://campusapi-development.up.railway.app

# Required: Canonical public origin of THIS service (scheme://host[:port], no
# path), e.g. https://<classroom-dev-domain>. Used to build absolute URLs,
# including the OAuth callback that flask_campus generates as
# {PUBLIC_URL}/finalize_login. This exact callback must be registered on the
# campus client's redirect_uris (see AGENTS.md) BEFORE login is used.
# Note: HOSTNAME is a bind address for the dev server and is NOT used for URL
# generation (the legacy https://{HOSTNAME} fallback is removed by campus#652).
PUBLIC_URL=https://<classroom-dev-domain>

# Required for Classroom features: Google OAuth client of THIS app (PRD
# §6.10.2 step 3). The callback {PUBLIC_URL}/classroom/callback must be
# registered as an authorized redirect URI on this client in Google Cloud
# Console (docs/auth-bridge.md).
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional: Google Workspace primary domain. When set, the Google consent
# screen is pinned to it (hd=) as a first-line identity guard; the app still
# enforces an exact email match with the Campus account either way.
WORKSPACE_DOMAIN=nyjc.edu.sg

# Optional: Server configuration
HOSTNAME=0.0.0.0
PORT=5000
